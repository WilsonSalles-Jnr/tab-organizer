{
  "manifest_version": 3,
  "name": "TabOrganizer",
  "version": "1.0.0",
  "description": "Organize suas abas por domínio em grupos nativos do Chrome.",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabOrganizer",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}